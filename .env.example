# Copy to .env for local builds. On your host, set these as build environment variables.
# ONLY public values belong here. NEVER put a service_role / secret key in this project.

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (or legacy "anon") key - safe for browsers because Row Level Security protects the data
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Public URL of the deployed site, used for canonical URLs, Open Graph and sitemap.xml
SITE_URL=https://example.com
# Name shown in the header and page titles
SITE_NAME=WhatsApp Contact Hub
